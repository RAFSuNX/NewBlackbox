<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/other" app:iconSpaceReserved="false">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root"
                app:summary="@string/hide_root_summary"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable"
                app:summary="@string/daemon_enable_summary"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="send_logs"
                android:title="@string/send_logs"
                android:summary="@string/send_logs_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
